{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pesquisa-iptu/decisao/v1.1",
 "title": "Decisao (registro canonico) — PESQUISA-IPTU v1.1 (campos independentes obrigatorios por questao)",
 "type": "object",
 "required": [
  "id",
  "versao_schema",
  "identificacao",
  "datas",
  "fonte",
  "questoes",
  "qualidade",
  "via_descoberta",
  "estado"
 ],
 "$defs": {
  "nulo_motivado": {
   "type": "object",
   "required": [
    "valor",
    "motivo"
   ],
   "properties": {
    "valor": {
     "type": "null"
    },
    "motivo": {
     "enum": [
      "nao_informado",
      "nao_localizado",
      "nao_aplicavel",
      "ilegivel",
      "nao_verificado"
     ]
    }
   }
  },
  "texto_ou_nulo": {
   "oneOf": [
    {
     "type": "string"
    },
    {
     "$ref": "#/$defs/nulo_motivado"
    }
   ]
  },
  "data_ou_nulo": {
   "oneOf": [
    {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    {
     "$ref": "#/$defs/nulo_motivado"
    }
   ]
  },
  "excerto": {
   "type": "object",
   "required": [
    "texto"
   ],
   "properties": {
    "texto": {
     "type": "string"
    },
    "localizador": {
     "type": "string",
     "description": "campo:offset_ini-offset_fim no texto de hash sha256_texto"
    },
    "voz": {
     "enum": [
      "juiz",
      "relator",
      "voto_vencedor",
      "voto_vencido",
      "parte",
      "precedente_citado",
      "ementa",
      "certidao"
     ]
    },
    "conferido_no_original": {
     "type": "boolean"
    }
   }
  }
 },
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^DEC-[A-Z0-9]+-[0-9a-f]{12}$"
  },
  "versao_schema": {
   "const": "v1"
  },
  "identificacao": {
   "type": "object",
   "required": [
    "tribunal",
    "grau",
    "numero_processo",
    "especie_ato"
   ],
   "properties": {
    "tribunal": {
     "type": "string"
    },
    "grau": {
     "enum": [
      "1G",
      "2G",
      "TR",
      "STJ",
      "STF",
      "ADM"
     ]
    },
    "orgao": {
     "$ref": "#/$defs/texto_ou_nulo"
    },
    "relator_julgador": {
     "$ref": "#/$defs/texto_ou_nulo"
    },
    "classe": {
     "$ref": "#/$defs/texto_ou_nulo"
    },
    "numero_processo": {
     "type": "object",
     "required": [
      "original"
     ],
     "properties": {
      "original": {
       "type": "string"
      },
      "normalizado": {
       "type": "string"
      }
     }
    },
    "id_oficial": {
     "$ref": "#/$defs/texto_ou_nulo"
    },
    "especie_ato": {
     "enum": [
      "acordao",
      "decisao_monocratica",
      "sentenca",
      "decisao_interlocutoria",
      "tutela",
      "integrativa",
      "sumula",
      "tese_qualificada",
      "decisao_administrativa"
     ]
    },
    "litigio_relacionado": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "datas": {
   "type": "object",
   "properties": {
    "julgamento": {
     "$ref": "#/$defs/data_ou_nulo"
    },
    "publicacao": {
     "$ref": "#/$defs/data_ou_nulo"
    },
    "disponibilizacao": {
     "$ref": "#/$defs/data_ou_nulo"
    },
    "coleta": {
     "type": "string"
    },
    "ultima_conferencia": {
     "type": [
      "string",
      "null"
     ]
    },
    "divergencias": {
     "type": "array"
    }
   }
  },
  "fonte": {
   "type": "object",
   "required": [
    "canal",
    "ponteiro",
    "sha256"
   ],
   "properties": {
    "canal": {
     "type": "string",
     "description": "F_TJBA | F_STJ | F_STF | F_PANGEA | COGNITIO | DJEN | PDPJ | PORTAL"
    },
    "ponteiro": {
     "type": "string",
     "description": "arquivo:linha ou id nativo"
    },
    "sha256": {
     "type": "string"
    },
    "sha256_texto": {
     "type": "string"
    },
    "procedencias": {
     "type": "array"
    }
   }
  },
  "contexto": {
   "type": "object",
   "properties": {
    "municipio": {
     "$ref": "#/$defs/texto_ou_nulo"
    },
    "exercicios": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "diplomas_municipais": {
     "type": "array"
    },
    "fatos_relevantes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/excerto"
     }
    },
    "provas_mencionadas": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "partes": {
   "type": "object",
   "properties": {
    "contribuinte_polo": {
     "enum": [
      "autor",
      "reu",
      "recorrente",
      "recorrido",
      "impetrante",
      "embargante",
      "excipiente",
      "executado",
      "indeterminado"
     ]
    },
    "ente_tributante": {
     "$ref": "#/$defs/texto_ou_nulo"
    },
    "recorrente": {
     "$ref": "#/$defs/texto_ou_nulo"
    }
   }
  },
  "questoes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "tributo",
     "eixo",
     "pergunta",
     "materia_examinada",
     "resultado",
     "natureza_beneficio",
     "provisoriedade",
     "efeito_sobre_ato_anterior"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^DEC-.+#Q[0-9]+$"
     },
     "chave_questao_comparavel": {
      "type": [
       "string",
       "null"
      ]
     },
     "tributo": {
      "enum": [
       "IPTU",
       "TAXA_LIXO",
       "COSIP",
       "ITBI",
       "ISS",
       "OUTRO"
      ]
     },
     "eixo": {
      "type": "string",
      "pattern": "^IPTU-[0-9]{2}$"
     },
     "subtema": {
      "type": "string"
     },
     "pergunta": {
      "type": "string"
     },
     "materia_examinada": {
      "enum": [
       "merito",
       "admissibilidade",
       "processual",
       "cautelar",
       "sucumbencial",
       "nao_examinada"
      ]
     },
     "resultado": {
      "enum": [
       "favoravel_integral",
       "favoravel_parcial",
       "desfavoravel",
       "sem_exame",
       "indeterminavel"
      ]
     },
     "objeto_do_resultado": {
      "type": "string"
     },
     "natureza_beneficio": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "material",
       "processual",
       "provisorio",
       "probatorio",
       "sucumbencial",
       null
      ]
     },
     "provisoriedade": {
      "enum": [
       "definitiva_na_instancia",
       "provisoria",
       "nao_aplicavel"
      ]
     },
     "efeito_sobre_ato_anterior": {
      "enum": [
       "mantem",
       "reforma",
       "reforma_parcial",
       "anula",
       "integra",
       "nao_aplicavel",
       "indeterminado"
      ]
     },
     "fundamento_determinante": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/excerto"
      }
     },
     "argumentos_rejeitados": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/excerto"
      }
     },
     "normas": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "precedentes_usados": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "ref": {
         "type": "string"
        },
        "uso": {
         "enum": [
          "aplicacao_determinante",
          "distincao",
          "referencia_incidental",
          "transcricao_de_alegacao",
          "discordancia"
         ]
        }
       }
      }
     },
     "teses": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^TES-[0-9]{3}$"
      }
     }
    }
   }
  },
  "dispositivo": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/excerto"
   }
  },
  "trajetoria": {
   "type": "object",
   "properties": {
    "anteriores": {
     "type": "array"
    },
    "posteriores": {
     "type": "array"
    },
    "situacao_na_data_de_corte": {
     "enum": [
      "mantida",
      "reformada",
      "suspensa",
      "anulada",
      "complementada",
      "transitada_comprovada",
      "situacao_posterior_nao_localizada",
      "nao_pesquisada"
     ]
    },
    "fonte_conferencia": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "qualidade": {
   "type": "object",
   "required": [
    "completude",
    "leitura"
   ],
   "properties": {
    "completude": {
     "enum": [
      "inteiro_teor",
      "ementa_e_dispositivo",
      "so_ementa",
      "trecho_publicado",
      "metadados"
     ]
    },
    "leitura": {
     "enum": [
      "nao_lida",
      "lida_parcialmente",
      "disponivel_lido_integralmente",
      "inteiro_teor_lido"
     ]
    },
    "verificacao": {
     "enum": [
      "nao_verificada",
      "excertos_conferidos",
      "antialucinacao_aprovada"
     ]
    },
    "revisor": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "quem": {
        "type": "string"
       },
       "tipo": {
        "enum": [
         "automatizada",
         "humana"
        ]
       },
       "data": {
        "type": "string"
       }
      }
     }
    },
    "pendencias": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "via_descoberta": {
   "type": "array",
   "items": {
    "enum": [
     "neutra_sistematica",
     "dirigida_favoravel",
     "referencia_de_decisao",
     "material_interno",
     "outra_documentada"
    ]
   },
   "minItems": 1
  },
  "estado": {
   "enum": [
    "candidato",
    "pendente",
    "elegivel",
    "classificado",
    "verificado",
    "excluido"
   ]
  },
  "exclusao": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "motivo": {
     "type": "string",
     "pattern": "^EXC-[0-9]{2}$"
    },
    "nota": {
     "type": "string"
    }
   }
  },
  "historico": {
   "type": "array"
  }
 }
}